# Copy to .env.local. Without a key the app still works: ingestion falls back to a
# rule-based parser and the briefing to a deterministic template.

# Recommended. Team passcode required to use the AI, read or change the saved portfolio and see the
# audit trail. Leave empty only for solo use on your own machine (the header then shows "No passcode set").
# Changing it signs everyone out.
APP_ACCESS_TOKEN=

# Optional. Accepted offers are stored here; the default is data/nzoia.sqlite.
# NZOIA_DB_PATH=C:\path\to\nzoia.sqlite

# Option A — Google Gemini (free tier key from https://aistudio.google.com/apikey).
# Takes precedence over OpenAI when set. "gemini-flash-latest" tracks Google's current Flash model;
# if a pinned model is retired the app falls back automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Option B — any OpenAI-compatible chat-completions endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
